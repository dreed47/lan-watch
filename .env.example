# Beelink running Frigate. The app SSHes there and reads go2rtc's own byte counters.
BEELINK_HOST=192.168.86.16
BEELINK_USER=david
SSH_KEY=/run/ssh/id_ed25519

# Host port for the web page. Inside the container the app listens on 5000.
PORT=7852

# Starting gap between checks, in seconds. The page can change this later.
POLL_SECONDS=60
SAMPLE_SECONDS=10
TZ=America/New_York
