# Machine that runs Frigate. The app SSHes there and reads go2rtc's byte counters.
FRIGATE_HOST=192.168.1.10
FRIGATE_USER=frigate
SSH_KEY=/run/ssh/id_ed25519

# Host port for the web page. Inside the container the app listens on 5000.
PORT=7852

# Optional. Used to suggest other devices. Create the token in Home Assistant:
# Profile, Security, Long-lived access tokens. Leave the token blank to skip this.
HA_URL=http://192.168.1.2:8123
HA_TOKEN=

# Starting gap between checks, in seconds. The page can change this later.
POLL_SECONDS=60
SAMPLE_SECONDS=10
TZ=America/New_York
